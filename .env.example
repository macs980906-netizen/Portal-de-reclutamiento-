# ----------------------------------------------------------------------------
# Portal de reclutamiento RiderMex — variables de entorno
# Copia este archivo a `.env` y completa los valores. Nunca subas `.env` al repo.
# ----------------------------------------------------------------------------

# development | staging | production  (production activa los bloqueos de lanzamiento)
APP_ENV=development
# URL pública del sitio (en producción debe ser https://)
APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://ridermex:ridermex@localhost:5432/ridermex_reclutamiento?schema=public

# Secreto para HMAC de teléfono/correo/IP (detección de duplicados y límites de uso).
# Producción: valor aleatorio de 32+ caracteres, p. ej. `openssl rand -base64 48`.
HASH_SECRET=dev-solo-local-cambiar-en-produccion-0000

# true sólo si la app está detrás de un proxy/CDN confiable que fija X-Forwarded-For
TRUST_PROXY_HEADERS=false

# --- Almacenamiento privado de CV -------------------------------------------
# local: carpeta privada fuera de /public (requiere disco persistente)
# s3: bucket PRIVADO compatible con S3 (AWS S3, Cloudflare R2, MinIO, etc.)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/private
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true   # sólo si el disco es persistente y respaldado
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=              # vacío para AWS; URL del endpoint para R2/MinIO
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
CV_MAX_MB=5

# --- Notificaciones al equipo -----------------------------------------------
# console (desarrollo, no envía nada) | whatsapp_cloud | twilio | none
NOTIFY_PROVIDER=console
# Formato: Nombre|+52XXXXXXXXXX,Nombre|+52XXXXXXXXXX   (no versionar números reales)
NOTIFY_WHATSAPP_RECIPIENTS=

# WhatsApp Cloud API (Meta)
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_NAME=nueva_candidatura
# WHATSAPP_TEMPLATE_LANG=es_MX

# Twilio WhatsApp
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_CONTENT_SID=       # plantilla aprobada (recomendado en producción)
