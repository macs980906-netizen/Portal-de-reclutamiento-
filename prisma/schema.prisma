// Esquema de datos del portal de reclutamiento RiderMex.
// Migraciones reproducibles: `npm run db:migrate` (desarrollo) / `npm run db:deploy` (producción).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  REVIEWER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(REVIEWER)
  active       Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions Session[]
  notes    Note[]
  events   ApplicationEvent[]
  audits   AuditLog[]
  cyclesClosed   RecruitmentCycle[] @relation("CycleClosedBy")
  cyclesCreated  RecruitmentCycle[] @relation("CycleCreatedBy")
  evaluationsReviewed Evaluation[]
}

/// Convocatoria (ciclo de reclutamiento). La shortlist sólo es definitiva al cerrarla.
model RecruitmentCycle {
  id               String    @id @default(cuid())
  name             String
  /// OPEN | REVIEW | CLOSED
  status           String    @default("OPEN")
  startsAt         DateTime
  endsAt           DateTime?
  /// Número objetivo de recomendaciones (inicialmente 5).
  targetCount      Int       @default(5)
  /// Umbral mínimo (0–100) para ser recomendada. 70 es un parámetro inicial por validar.
  threshold        Float     @default(70)
  /// Versión de rúbrica congelada al crear la convocatoria.
  rubricVersion    String
  eligibilityVersion String
  parentId         String?
  createdById      String?
  closedAt         DateTime?
  closedById       String?
  /// Instantánea inmutable de la shortlist calculada al cerrar.
  shortlist        Json?
  shortlistVersion Int       @default(0)
  /// Contador de reenvíos del aviso (control de duplicados).
  noticeSeq        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  parent        RecruitmentCycle?  @relation("CycleVersions", fields: [parentId], references: [id], onDelete: SetNull)
  children      RecruitmentCycle[] @relation("CycleVersions")
  createdBy     User?              @relation("CycleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  closedBy      User?              @relation("CycleClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  applications  Application[]
  notifications Notification[]

  @@index([status, createdAt])
}

/// Evaluación de una postulación con una versión concreta de la rúbrica. Nunca se
/// recalcula al cambiar de rúbrica: una versión nueva crea una evaluación nueva.
model Evaluation {
  id                 String    @id @default(cuid())
  applicationId      String
  rubricVersion      String
  questionSetVersion String
  /// PENDING | RUNNING | COMPLETED | NEEDS_REVIEW | FAILED
  status             String    @default("PENDING")
  /// AI | MANUAL
  source             String    @default("AI")
  provider           String?
  model              String?
  /// Resultado por dimensión: score 0–4, evidence, rationale, confidence, needs_human_review, review_reason.
  dimensions         Json?
  /// Pesos usados (copia congelada) para convertir 0–4 a puntos.
  weights            Json?
  total              Float?
  needsReview        Boolean   @default(false)
  reviewReasons      Json?
  /// Resultado original de la IA si una persona lo reemplazó manualmente.
  aiDimensions       Json?
  attempts           Int       @default(0)
  lastError          String?
  /// SHA-256 de la entrada enviada al proveedor (sin datos personales) para auditoría.
  inputDigest        String?
  reviewedById       String?
  reviewedAt         DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([applicationId, rubricVersion])
  @@index([status])
}

/// Sesiones de panel. Sólo se guarda el hash SHA-256 del token; el token vive en una cookie HttpOnly.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Application {
  id            String  @id @default(cuid())
  /// Código de postulación no secuencial que ve la persona candidata (p. ej. RMX-7K4P-Q9TD).
  code          String  @unique
  /// Clave de idempotencia generada en el navegador; evita duplicados por doble envío o reintentos.
  submissionKey String  @unique

  // Paso A — Contacto
  firstName String
  lastName  String
  phone     String
  email     String?
  /// HMAC de teléfono/correo normalizados para detectar duplicados sin exponerlos.
  phoneHash String
  emailHash String?

  // Paso B — Preferencias y disponibilidad
  agencyFirst           String?
  agencySecond          String?
  anyAgency             Boolean  @default(false)
  generalArea           String?
  canCommute            String
  interviewAvailability String[]
  scheduleTalk          String?
  scheduleAcknowledged  Boolean?

  // Paso C — Experiencia
  productsSold       String?
  /// Sólo en postulaciones del desafío v1 (en v2 la pregunta 6 cubre esta evidencia).
  helpedDecideStory  String?
  followupExperience String
  followupDetail     String?
  yearsExperience    String?
  /// Señal contextual (no suma al puntaje): ¿ha vendido motos/autos o trabajado en agencia?
  vehicleSalesExperience String?

  // Paso D — Interés
  interestVacancy String
  interestTopics  String[]
  interestDetail  String?

  // Paso E — Desafío de ventas
  challengeAnswers   Json
  /// Versión del conjunto de preguntas contestado.
  questionSetVersion String  @default("desafio-2026-09-v1")
  /// Versión de rúbrica asignada al recibirla (la de su convocatoria).
  rubricVersion      String?

  /// Puntaje orientativo vigente (copia del total de la evaluación final; null = pendiente).
  scoreTotal      Float?
  /// Campos del puntaje por reglas del desafío v1 (histórico).
  scoreBreakdown  Json?
  scoreIndicators Json?
  scoringVersion  String?

  // Convocatoria
  cycleId    String?
  /// Llegó cuando la convocatoria ya no estaba abierta: no entra a la shortlist cerrada.
  afterClose Boolean @default(false)
  /// Se informó a la persona que sus respuestas se evalúan con apoyo de IA.
  aiEvaluationNotice Boolean @default(false)

  // Revisión humana
  status           String    @default("NUEVO")
  priority         Int       @default(0)
  priorityReason   String?
  humanRating      Int?
  reviewedAt       DateTime?
  possibleDuplicate Boolean  @default(false)

  // Consentimiento (registro de aviso aceptado)
  privacyNoticeVersion   String
  privacyAcceptedAt      DateTime
  futureVacanciesConsent Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cv            CvFile?
  attribution   Attribution?
  notes         Note[]
  events        ApplicationEvent[]
  notifications Notification[]
  evaluations   Evaluation[]
  cycle         RecruitmentCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([cycleId])
  @@index([createdAt])
  @@index([status])
  @@index([agencyFirst])
  @@index([scoreTotal])
  @@index([phoneHash])
  @@index([emailHash])
}

/// CV almacenado en almacenamiento privado. Nunca se sirve desde una URL pública.
model CvFile {
  id            String      @id @default(cuid())
  applicationId String      @unique
  storageKey    String      @unique
  originalName  String
  mimeType      String
  sizeBytes     Int
  sha256        String
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

/// Atribución de campaña, separada de las respuestas.
model Attribution {
  applicationId String      @id
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  utmTerm       String?
  referrer      String?
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Note {
  id            String      @id @default(cuid())
  applicationId String
  authorId      String?
  body          String
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author        User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([applicationId])
}

/// Registro de cambios por expediente (estado, calificación humana, prioridad, accesos a contacto y CV).
model ApplicationEvent {
  id            String      @id @default(cuid())
  applicationId String
  actorId       String?
  type          String
  fromValue     String?
  toValue       String?
  reason        String?
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor         User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
}

/// Auditoría general (inicios de sesión, exportaciones, borrados). No guarda respuestas ni documentos.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  targetId  String?
  meta      Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
}

/// Notificaciones al equipo. `dedupeKey` impide duplicar envíos por reintentos.
model Notification {
  id                String      @id @default(cuid())
  /// NEW_APPLICATION | SHORTLIST
  kind              String      @default("NEW_APPLICATION")
  applicationId     String?
  cycleId           String?
  /// Parámetros no sensibles del mensaje (nombre corto, agencia, conteos, enlace).
  payload           Json?
  dedupeKey         String      @unique
  channel           String
  provider          String
  recipientLabel    String
  recipientMasked   String
  status            String
  attempts          Int         @default(0)
  lastError         String?
  providerMessageId String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  sentAt            DateTime?
  application       Application?      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  cycle             RecruitmentCycle? @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([kind, cycleId])
}

/// Contador simple para límites de uso (anti-spam). La clave es un hash, nunca una IP en claro.
model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime
}

/// Embudo agregado sin datos personales: cuántas personas iniciaron el formulario por día.
model FunnelDaily {
  day     String @id
  started Int    @default(0)
}
